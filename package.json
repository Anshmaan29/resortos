{
  "name": "resortos",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait postgres minio && docker compose run --rm minio-init",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @resortos/api migrate",
    "db:seed": "pnpm --filter @resortos/api seed",
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter @resortos/api dev",
    "dev:web": "pnpm --filter @resortos/web dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify": "pnpm build && pnpm typecheck && pnpm test",
    "e2e": "pnpm --filter @resortos/shared build && pnpm --filter @resortos/api build && pnpm --filter @resortos/web build && playwright test",
    "audit": "node ops/ci/audit.mjs",
    "https:setup": "bash ops/dev-https/setup-lan.sh",
    "https:off": "bash ops/dev-https/teardown-lan.sh",
    "dev:api:lan": "bash ops/dev-https/api-lan.sh",
    "dev:web:lan": "bash ops/dev-https/web-lan.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  },
  "pnpm": {
    "overrides": {
      "multer": "2.3.0",
      "source-map-js": "1.2.2"
    }
  }
}
