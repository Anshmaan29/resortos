RESORTOS_ENV=development
# API
DATABASE_URL=postgres://resortos_app:app_dev_password@localhost:5433/resortos
MIGRATION_DATABASE_URL=postgres://resortos_migrator:migrator_dev_password@localhost:5433/resortos
TEST_DATABASE_URL=postgres://resortos_migrator:migrator_dev_password@localhost:5433/resortos_test
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
SESSION_COOKIE_SECURE=false
# Web
NEXT_PUBLIC_API_URL=http://localhost:4000

# Phone testing on the local network: run `pnpm https:setup` (writes .env.lan). See docs/phone-testing.md.

# Object storage: MinIO in development (S3 API, same code path as production)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=resortos-documents-dev
S3_ACCESS_KEY_ID=resortos
S3_SECRET_ACCESS_KEY=resortos-dev-minio-secret
S3_FORCE_PATH_STYLE=true
