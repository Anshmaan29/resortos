{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "API_ORIGIN=http://127.0.0.1:4000 pnpm build"
  },
  "deploy": {
    "startCommand": "node ops/railway/start.mjs",
    "healthcheckPath": "/api/v1/health/db",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
