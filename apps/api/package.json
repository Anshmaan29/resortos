{
  "name": "@resortos/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "dev": "node --env-file=../../.env --watch -r ./scripts/swc-register.cjs src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "migrate": "node --env-file-if-exists=../../.env -r ./scripts/swc-register.cjs scripts/migrate.ts",
    "seed": "node --env-file-if-exists=../../.env -r ./scripts/swc-register.cjs scripts/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.5",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.2",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.3",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "typescript": "5.9.3",
    "unplugin-swc": "1.6.0",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1133.0",
    "@aws-sdk/s3-request-presigner": "3.1135.0",
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "@resortos/shared": "workspace:*",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "pdfkit": "0.20.2",
    "pg": "8.23.0",
    "pg-boss": "12.33.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  }
}
